<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.caso_3.HelloController">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="Caja de ventas concurrente"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label fx:id="vendedor1Label" text="Vendedor 1: 0 / 5"/>
    <ProgressBar fx:id="vendedor1Barra" progress="0.0" prefWidth="350.0"/>

    <Label fx:id="vendedor2Label" text="Vendedor 2: 0 / 5"/>
    <ProgressBar fx:id="vendedor2Barra" progress="0.0" prefWidth="350.0"/>

    <Label fx:id="vendedor3Label" text="Vendedor 3: 0 / 5"/>
    <ProgressBar fx:id="vendedor3Barra" progress="0.0" prefWidth="350.0"/>

    <Label fx:id="totalVentasLabel" text="Total de ventas: 0"/>
    <Label fx:id="recaudacionLabel" text="Recaudación: C$0"/>
    <Label fx:id="estadoLabel" text="Estado: listo"/>

    <HBox alignment="CENTER" spacing="12.0">
        <Button fx:id="iniciarButton"
                text="Iniciar"
                onAction="#iniciarSimulacion"/>

        <Button fx:id="cancelarButton"
                text="Cancelar"
                disable="true"
                onAction="#cancelarSimulacion"/>
    </HBox>

</VBox>